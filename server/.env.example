PORT=4000
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-too
DB_PATH=./medibridge.db
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Upload storage
UPLOAD_DIR=./uploads

# OCR Provider (leave blank to use manual fallback)
# Options: tesseract_local | google_vision | aws_textract
OCR_PROVIDER=
GOOGLE_VISION_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Notification providers (leave blank to use in-app fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WATI_API_ENDPOINT=
WATI_API_TOKEN=
