{
  "name": "medibridge-server",
  "version": "1.0.0",
  "description": "MediBridge backend API server",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
